---
import '@fontsource/nunito-sans/400.css';
import '@fontsource/nunito-sans/600.css';
import '@fontsource/nunito-sans/700.css';
import '@fontsource/nunito-sans/800.css';
import '@fontsource/noto-sans-arabic/400.css';
import '@fontsource/noto-sans-arabic/600.css';
import '@fontsource/noto-sans-arabic/700.css';
import '@fontsource/noto-sans-arabic/800.css';
import '@phosphor-icons/web/regular';
import '../styles/global.css';
import '../styles/hero.css';
import '../styles/navigation.css';
import '../styles/card-motion.css';
const {
  canonical = undefined,
  language = 'fr',
  title = 'Moul Pounj — الراحة لي كتستاهل',
  description = 'Découvrez les matelas, salons marocains et oreillers Moul Pounj. Trouvez le confort adapté à votre maison et votre magasin au Maroc.',
} = Astro.props;
const shareUrl = new URL(Astro.url.pathname, Astro.site ?? 'https://site-moulpounj.vercel.app').href;
const shareImage = new URL('/images/logo.png', Astro.site ?? 'https://site-moulpounj.vercel.app').href;
---

<!doctype html>
<html lang={language}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta name="robots" content="noindex,nofollow" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Moul Pounj" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={shareUrl} />
    <meta property="og:image" content={shareImage} />
    <meta property="og:image:secure_url" content={shareImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="994" />
    <meta property="og:image:height" content="434" />
    <meta property="og:image:alt" content="مول البونج — Moul Pounj" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={shareImage} />
    <meta name="theme-color" content="#de5625" />
    <title>{title}</title>
  </head>
  <body id="accueil">
    <slot />
    <script>
      if (document.querySelector('#service-dialog')) {
        void import('../lib/client');
        void import('../lib/card-motion');
      }
    </script>
  </body>
</html>
