---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Dialogs from '../components/Dialogs.astro';
import Icon from '../components/Icon.astro';
import '../styles/cart-page.css';
---
<Layout language="ar" title="السلة ديالك | Panier Moul Pounj" description="راجع السلة ديالك ووجد طلبك مع مول البونج.">
<Header/>
<main id="contenu" class="cart-page" dir="rtl">
 <section class="cart-intro cart-width"><h1>السلة ديالك</h1><p>راجع الاختيارات ديالك، وكمل الطلب على راحتك.</p><ol class="cart-steps"><li aria-current="step"><b>1</b>السلة</li><li><b>2</b>معلومات التوصيل</li><li><b>3</b>مراجعة الطلب</li></ol><a href="/matelas" class="cart-continue">مواصلة التسوق <Icon name="arrow-left"/></a></section>
 <div class="cart-width"><div id="cart-demo-note" hidden class="cart-demo-note">معاينة فقط · منتجات وأثمنة توضيحية، ماشي طلب حقيقي.</div><div class="cart-layout">
 <div class="cart-main"><section class="cart-box"><h2>المنتجات المختارة <span id="cart-line-count"></span></h2><div id="cart-items"></div><div id="cart-empty"><Icon name="shopping-cart"/><h3>السلة ديالك مازال خاوية</h3><p>اكتشف المنتجات وتأكد من الثمن والتوفر مع فريقنا.</p><a class="cart-primary" href="/matelas">اكتشف الماتلات</a>{import.meta.env.DEV&&<button id="cart-load-demo" class="cart-text-button">عرض سلة تجريبية لمعاينة التصميم</button>}</div><div class="cart-coupon"><Icon name="seal-percent"/><span>عندك كود تخفيض؟</span><small>أكواد التخفيض مازال ما تفعّلوش.</small></div></section>
 <section class="cart-discover"><h2>اكتشف كذلك</h2><div>{[{name:'ماتلات مول البونج',href:'/matelas',image:'/images/reference/category-matelas.webp'},{name:'وسادة Sublimya Visco',href:'/produit/oreiller-sublimya-visco',image:'/images/hero/pillows.webp'},{name:'الصالون المغربي',href:'/salon-marocain',image:'/images/hero/salon.webp'}].map(p=><a href={p.href}><img src={p.image} alt="صورة توضيحية" width="400" height="240" loading="lazy"/><h3>{p.name}</h3><span>شوف التفاصيل ←</span></a>)}</div></section></div>
 <aside class="cart-aside"><section class="cart-box cart-summary"><h2><Icon name="receipt"/>ملخص الطلب</h2><dl><div><dt>المجموع الفرعي</dt><dd data-cart-subtotal>0 درهم</dd></div><div><dt>مصاريف التوصيل</dt><dd>تتأكد حسب العنوان</dd></div></dl><div class="cart-total"><strong>المجموع بدون توصيل</strong><b data-cart-subtotal>0 درهم</b></div><button id="open-checkout" class="cart-primary" disabled>كمل الطلب <Icon name="arrow-left"/></button><small>الثمن النهائي والتوفر كيتأكدو مع الفريق.</small></section><section class="cart-box cart-help"><Icon name="headset"/><h2>عندك شي سؤال قبل ما تكمل؟</h2><p>فريقنا هنا للمساعدة</p><button data-contact="Bonjour, j’ai une question concernant mon panier." class="cart-whatsapp"><Icon name="whatsapp-logo"/>تواصل معنا على واتساب</button></section></aside>
 </div><p id="cart-status" role="status" aria-live="polite"></p></div>
</main>
<dialog id="checkout-drawer" aria-labelledby="checkout-title" dir="rtl"><div class="checkout-head"><div><span>مول البونج · طلبك</span><h2 id="checkout-title">نكملو المعلومات ديالك</h2></div><button id="close-checkout" aria-label="Fermer le formulaire"><Icon name="x"/></button></div><div class="checkout-content"><div class="checkout-order"><h3>ملخص السلة</h3><div id="checkout-items"></div><strong>المجموع بدون توصيل <b data-cart-subtotal></b></strong></div><form id="checkout-form"><p>غير هاد المعلومات باش نوجدو طلبك ونتواصلو معاك.</p><div class="checkout-field"><label for="order-name">الاسم الكامل</label><input id="order-name" name="name" autocomplete="name" required minlength="2" maxlength="100" placeholder="الاسم والنسب"/></div><div class="checkout-field"><label for="order-phone">رقم الهاتف</label><input id="order-phone" name="phone" type="tel" inputmode="tel" autocomplete="tel" required maxlength="25" placeholder="06 00 00 00 00" dir="ltr"/></div><div class="checkout-field checkout-field-wide"><label for="order-city">المدينة</label><input id="order-city" name="city" autocomplete="address-level2" required maxlength="100" placeholder="المدينة ديالك"/></div><div class="checkout-field checkout-field-wide"><label for="order-address">عنوان التوصيل</label><textarea id="order-address" name="address" autocomplete="street-address" required minlength="5" maxlength="400" rows="2" placeholder="الحي، الزنقة، رقم الدار أو الشقة"></textarea></div><details class="checkout-notes"><summary>زيد ملاحظة (اختياري)</summary><textarea name="notes" maxlength="500" rows="2" aria-label="ملاحظة للطلب" placeholder="شي معلومة تساعدنا فالتوصيل"></textarea></details><p class="checkout-disclosure">ما كاين حتى أداء فهاد المرحلة. راجع الطلب قبل مشاركته، والفريق كيأكد الثمن والتوصيل والتوفر.</p><button class="cart-primary" type="submit">راجع الطلب <Icon name="arrow-left"/></button></form><section id="checkout-review" hidden><div id="checkout-success" class="checkout-success" role="status" tabindex="-1"><Icon name="check-circle"/><div><h3>المعلومات ديالك تكملات بنجاح!</h3><p>ملخص الطلب واجد للمراجعة. الطلب مازال ما تسيفطش؛ راجع المعلومات لتحت قبل المشاركة.</p></div></div><h3>راجع المعلومات قبل المشاركة</h3><textarea id="checkout-message" readonly rows="12" aria-label="ملخص الطلب للمراجعة"></textarea><p id="checkout-review-note"></p><a id="checkout-send" class="cart-whatsapp" target="_blank" rel="noopener noreferrer" hidden><Icon name="whatsapp-logo"/>فتح الطلب في واتساب</a><button id="checkout-copy" class="cart-primary" type="button">نسخ ملخص الطلب <Icon name="copy"/></button><button id="checkout-edit" class="cart-text-button" type="button">تعديل المعلومات</button><p id="checkout-state" role="status" aria-live="polite"></p></section></div></dialog>
<Footer showBanner={false}/><Dialogs/>
</Layout>
<script>import '../lib/cart-page';</script>
