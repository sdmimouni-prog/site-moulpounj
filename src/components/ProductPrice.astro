---
interface Props {
  priceMAD?: number;
}
const { priceMAD } = Astro.props;
const available =
  typeof priceMAD === 'number' && Number.isFinite(priceMAD) && priceMAD > 0;
---

<div
  class="product-price"
  aria-label={available ? 'Prix' : 'Prix non renseigné'}
>
  <span class="product-price-label">Prix</span>
  {available ? (
    <bdi class="product-price-amount" dir="ltr">
      {new Intl.NumberFormat('fr-MA', { maximumFractionDigits: 2 }).format(
        priceMAD!,
      )}{' '}
      <small>MAD</small>
    </bdi>
  ) : (
    <span class="product-price-pending">À confirmer</span>
  )}
</div>
<style>
  .product-price {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 6px 12px;
    min-height: 38px;
    margin: 6px 0 4px;
  }
  .product-price-label {
    font-size: 12px;
    color: #73685f;
  }
  .product-price-amount {
    font-size: 24px;
    line-height: 1.5;
    font-weight: 800;
    color: var(--orange-dark);
  }
  .product-price-amount small {
    font-size: 13px;
    font-weight: 700;
  }
  .product-price-pending {
    font-size: 18px;
    font-weight: 800;
    color: var(--orange-dark);
  }
  @media (max-width: 600px) {
    .product-price {
      gap: 4px 8px;
    }
    .product-price-amount {
      font-size: 20px;
    }
    .product-price-pending {
      font-size: 16px;
    }
  }
</style>
