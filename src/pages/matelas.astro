---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Dialogs from '../components/Dialogs.astro';
import Icon from '../components/Icon.astro';
import {mattresses,mattressDimensions,mattressPrice,technologyLabel} from '../data/mattresses';
import '../styles/mattresses.css';
---
<Layout title="Nos matelas | Moul Pounj" description="Découvrez les matelas Moul Pounj : filtres par confort, dimensions et technologie, et comparaison des modèles.">
<Header/>
<main id="contenu" class="mattress-catalog">
 <section class="mc-hero"><img src="/images/navigation/mattress-room.webp" alt="Matelas dans une chambre chaleureuse — illustration" width="1600" height="700" fetchpriority="high"/><div class="container mc-wrap"><nav aria-label="Fil d’Ariane" class="mc-breadcrumb"><a href="/">Accueil</a><span>/</span><span aria-current="page">Nos matelas</span></nav><div class="mc-hero-copy"><h1>Nos matelas</h1><h2 dir="rtl">نعاسك على <em>قياسك.</em></h2><p dir="rtl">لقى الماتلا اللي توالم راحتك وميزانيتك.</p></div><div class="mc-hero-benefits">{[{icon:'seal-check',text:'Choisir sa literie'},{icon:'bed',text:'Trouver son confort'},{icon:'tag',text:'Comparer les modèles'}].map(item=><span><Icon name={item.icon}/>{item.text}</span>)}</div></div></section>
 <div class="container mc-wrap">
 <p class="mc-demo">Catalogue récupéré de moulpounj.ma · Prix publiés le 18/09/2026. Disponibilité à confirmer avant commande.</p>
 <div class="mc-layout">
  <aside class="mc-sidebar"><button class="mc-mobile-filters" aria-expanded="false" aria-controls="mc-filter-panel"><Icon name="sliders-horizontal"/>Filtrer les matelas <Icon name="caret-down"/></button><div id="mc-filter-panel"><form id="mc-filters"><div class="mc-filter-heading"><h2>Filtrer</h2><button type="reset">Réinitialiser</button></div>
   <details open><summary>Dimensions <Icon name="caret-down"/></summary><div class="mc-dimensions">{mattressDimensions.map(size=><label><input type="checkbox" name="dimension" value={size}/><span>{size}</span></label>)}</div></details>
   <details open><summary>Confort <Icon name="caret-down"/></summary><div class="mc-checks">{['Ferme','Mi-ferme','Mi-souple'].map(value=><label><input type="checkbox" name="comfort" value={value}/>{value}</label>)}</div></details>
   <details open><summary>Budget <Icon name="caret-down"/></summary><label class="mc-range-label" for="mc-budget">Prix de départ maximum</label><input id="mc-budget" type="range" min="590" max="4990" step="10" value="4990" name="budget"/><div class="mc-budget-values"><span>590 DH</span><output id="mc-budget-value" for="mc-budget">4 990 DH</output></div></details>
   <details open><summary>Technologie <Icon name="caret-down"/></summary><div class="mc-checks"><label><input type="checkbox" name="technology" value="mousse"/>Mousse</label><label><input type="checkbox" name="technology" value="ressorts"/>Ressorts ensachés</label></div></details>
   <details><summary>Hauteur <Icon name="caret-down"/></summary><div class="mc-checks"><small>Hauteurs structurées non renseignées dans le catalogue récupéré.</small></div></details>
  </form></div><div class="mc-adviser"><Icon name="headset"/><div><h3 dir="rtl">مازال محتار؟</h3><p>Nos conseillers sont là pour vous aider à choisir le matelas idéal.</p></div><button class="mc-button" data-contact="Bonjour, je souhaite être conseillé pour choisir un matelas."><Icon name="chat-circle"/>Parler à un conseiller</button></div></aside>
  <section class="mc-results" aria-label="Catalogue des matelas"><div class="mc-toolbar"><div class="mc-tabs" role="group" aria-label="Type de matelas"><button data-mc-tab="all" aria-pressed="true">Tous les matelas</button><button data-mc-tab="mousse" aria-pressed="false">Mousse</button><button data-mc-tab="ressorts" aria-pressed="false">Ressorts ensachés</button></div><span id="mc-count" role="status" aria-live="polite">9 modèles</span><label class="mc-sort"><span class="sr-only">Trier les matelas</span><select id="mc-sort"><option value="default">Trier par : Notre sélection</option><option value="ascending">Prix croissant</option><option value="descending">Prix décroissant</option><option value="name">Nom du modèle</option></select></label></div>
   <div class="mc-grid">{mattresses.map((p,index)=><article class="mc-card" data-mc-id={p.id} data-mc-order={index}><a class="mc-image" href={`/produit/${p.slug}`} aria-label={`Découvrir ${p.name}`}><img src={p.image} style={`object-position:${p.position}`} alt={`${p.name} — photo du catalogue source`} width="600" height="360" loading="lazy"/></a><div class="mc-card-body"><h3>{p.name}</h3><div class="mc-tags"><span>{technologyLabel(p.technology)}</span>{p.comfort&&<span>{p.comfort}</span>}{p.height&&<span>{p.height} cm</span>}</div><div class="mc-price-row"><div>À partir de <strong>{mattressPrice(p.price)} DH</strong><small>Selon dimensions</small></div><label><input type="checkbox" data-mc-compare={p.id} aria-label={`Comparer ${p.name}`}/>Comparer</label></div><a class="mc-button" href={`/produit/${p.slug}`}>Choisir ma dimension <Icon name="arrow-right"/></a></div></article>)}</div><div id="mc-empty" hidden><Icon name="magnifying-glass"/><h2>Aucun modèle ne correspond à ces filtres</h2><p>Essayez d’élargir votre budget ou de modifier vos critères.</p><button class="mc-button" id="mc-reset-empty">Réinitialiser les filtres</button></div>
  </section>
 </div>
 <section id="comparaison" class="mc-compare-bar" aria-label="Comparer les matelas"><Icon name="scales"/><div><h2>Comparez jusqu’à 3 matelas</h2><p>Choisissez la même dimension pour comparer.</p></div><div id="mc-compare-slots"></div><button class="mc-button" id="mc-open-compare" aria-expanded="false" aria-controls="mc-comparison" disabled>Comparer (0/3)</button><p id="mc-compare-status" role="status" aria-live="polite"></p></section>
 <section id="mc-comparison" class="mc-comparison-panel" aria-labelledby="mc-comparison-title" hidden><button class="mc-close" aria-label="Fermer"><Icon name="x"/></button><h2 id="mc-comparison-title" tabindex="-1">Comparez vos matelas</h2><label for="mc-common-size">Dimension commune</label><select id="mc-common-size"></select><p id="mc-comparison-note"></p><p class="mc-table-hint">Faites défiler le tableau horizontalement pour voir tous les modèles.</p><div class="mc-table-scroll" tabindex="0" role="region" aria-label="Tableau comparatif des matelas, défilement horizontal"><table id="mc-comparison-table"></table></div><p class="mc-demo">Prix publiés pour la dimension sélectionnée. Caractéristiques absentes signalées « À confirmer ».</p></section>
 <section class="mc-help" aria-labelledby="mc-help-title"><div class="mc-help-copy"><h2 id="mc-help-title" dir="rtl">مازال محتار؟</h2><p>Échangez avec un conseiller ou venez essayer en magasin.</p></div><div class="mc-help-actions"><button class="mc-whatsapp" data-contact="Bonjour, je souhaite de l’aide pour choisir un matelas."><Icon name="whatsapp-logo"/>Parler sur WhatsApp</button><a href="/nos-magasins" class="mc-store"><Icon name="map-pin"/>Trouver un magasin</a></div></section>
 </div>

</main><Footer showBanner={false}/><Dialogs/>
</Layout>
<script>import '../lib/mattresses';</script>
