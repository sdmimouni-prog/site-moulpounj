---
import GuideLayout from '../../layouts/GuideLayout.astro';
import GuideSection from '../../components/guides/GuideSection.astro';
import Icon from '../../components/Icon.astro';
import { chooseMattressGuide as g } from '../../data/guides/choose-mattress';
const dev=import.meta.env.DEV;
---
<GuideLayout guide={g}>
 <GuideSection section={g.sections[0]} number={1}><div class="guide-three">{g.usage.map((u)=><div class="guide-tile">{u.image?<img src={u.image} alt="صورة أجواء توضيحية" loading="lazy" width="500" height="230"/>:<div class="guide-media-pending"><Icon name="image"/><span>صورة غرفة الأطفال قيد الإضافة</span></div>}<h3>{u.title}</h3><p class="guide-pending">{g.pending}</p></div>)}</div></GuideSection>
 <GuideSection section={g.sections[1]} number={2}><div class="guide-dimension-layout"><div><h3>القياسات المتوفرة</h3>{g.dimensions.length?<div class="guide-dimensions">{g.dimensions.map(d=><a href={`/matelas?dimension=${encodeURIComponent(d)}`}><Icon name="bed"/><bdi>{d}</bdi></a>)}</div>:<p class="guide-pending">{g.dimensionsNote}</p>}<aside class="guide-tip"><Icon name="lightbulb"/><span>الرسم والقياسات التقنية قيد الإضافة. صورة الأجواء ما كتحددش قياس المنتج.</span></aside></div><img src="/images/reference/product-1.webp" alt="صورة توضيحية للمرتبة، بدون قياسات تقنية" width="650" height="350" loading="lazy"/></div></GuideSection>
 <GuideSection section={g.sections[2]} number={3}><p>{g.comfortNote}</p><div class="guide-three">{g.comfort.map(c=><div class="guide-comfort"><Icon name="hand-palm"/><h3>{c}</h3><p class="guide-pending">التعريف المعتمد وصورة التفاصيل قيد الإضافة.</p></div>)}</div></GuideSection>
 <GuideSection section={g.sections[3]} number={4}><p>{g.budgetNote}</p><div class="guide-three guide-budgets">{g.budgets.map(b=><div><Icon name="coins"/><h3>{b}</h3><p class="guide-pending">الخصائص والأثمنة قيد التأكيد.</p></div>)}</div></GuideSection>
 <GuideSection section={g.sections[4]} number={5}><p>{g.technologyNote}</p><div class="guide-tech-layout"><aside class="guide-tip"><Icon name="seal-check"/><div><h3>الخلاصة</h3><p>خاص المقارنة تعتمد على البيانات المعتمدة ديال كل موديل.</p></div></aside><div class="guide-tech"><div class="guide-tech-head"><span>المعيار</span><span>الموس</span><span>الروسور</span></div>{g.criteria.map(c=><div class="guide-tech-row"><h3>{c}</h3><p><b>الموس</b>قيد التأكيد حسب الموديل</p><p><b>الروسور</b>قيد التأكيد حسب الموديل</p></div>)}</div><div class="guide-media-pending"><Icon name="stack"/><span>الصور التقنية للموس والروسور قيد الإضافة</span></div></div></GuideSection>
 {(dev||g.videos.length>0)&&<GuideSection section={g.sections[5]} number={6}>{g.videos.length?<div class="guide-videos">{g.videos.map(v=><div><video controls preload="none" poster={v.poster}><source src={v.src}/><track kind="captions" src={v.captions} srclang="ar" label="العربية" default/></video><h3>{v.title}</h3><span>{v.duration}</span></div>)}</div>:<div class="guide-empty"><Icon name="video-camera"/><p>الفيديوهات قيد الإضافة — معاينة التطوير فقط. ما كاين حتى فيديو متوفر دابا.</p></div>}</GuideSection>}
 <div class="guide-bottom-grid"><GuideSection section={g.sections[6]} number={7}>{g.related.length?<div class="guide-three">{g.related.map(p=><a class="guide-product" href={`/produit/${p.id}`}><img src={p.image} alt={p.name} width="400" height="240" loading="lazy"/><h3><bdi>{p.name}</bdi></h3><p>{p.description}</p><span>شوف التفاصيل ←</span></a>)}</div>:<div class="guide-empty"><Icon name="bed"/><p>المراجع المعتمدة وصورها مازال ما تزادوش للكاتالوغ. المنتجات المرتبطة غادي تبان هنا من بعد التحقق.</p><a href="/matelas">اكتشف معاينة الكاتالوغ ←</a></div>}</GuideSection><GuideSection section={g.sections[7]} number={8}><div class="guide-faq">{g.faq.map(q=><details><summary>{q}<Icon name="plus"/></summary><p class="guide-pending">{g.pending} تواصل مع فريق مول البونج للحصول على معلومات الموديل.</p></details>)}</div></GuideSection></div>
</GuideLayout>
