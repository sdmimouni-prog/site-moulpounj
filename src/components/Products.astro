---
import { site } from '../data/site';
import { products, productSlots } from '../data/catalog';
import Media from './Media.astro';
import Icon from './Icon.astro';
import ProductPrice from './ProductPrice.astro';
import '../styles/product-slider.css';
---

<section
  id="selection"
  class="container section products"
  aria-labelledby="products-title"
>
  <div class="section-heading split">
    <div>
      <p class="eyebrow orange">À DÉCOUVRIR</p>
      <h2 id="products-title">{site.headings.products}</h2>
    </div>
    <a class="text-link" href="#categories">
      Nos collections <Icon name="arrow-right" />
    </a>
  </div>
  <div class="filter-row" role="group" aria-label="Filtrer la sélection">
    <button data-filter="all" aria-pressed="true">
      Tout découvrir
    </button>
    {site.nav.map((c) => (
      <button data-filter={c.category} aria-pressed="false">
        {c.label}
      </button>
    ))}
  </div>
  <div
    class="product-grid product-slider"
    id="product-track"
    tabindex="0"
    role="region"
    aria-roledescription="carrousel"
    aria-label="Sélection de produits, utilisez les flèches ou faites glisser"
  >
    {products.map((p) => (
      <article class="product-card" data-product-category={p.category}>
        <Media src={p.image} alt={p.name} />
        <div class="product-body">
          <h3>{p.name}</h3>
          <p>{p.description}</p>
          <ProductPrice priceMAD={p.priceMAD} />
          <a class="button" href={`/produit/${p.id}`} aria-label={`Découvrir ${p.name}`}>
            Choisir ce produit
            <Icon name="arrow-right" />
          </a>
        </div>
      </article>
    ))}
    {products.length === 0 &&
      productSlots.map((p) => (
        <article class="product-card" data-product-category={p.category}>
          <div class="product-picture">
            <Media
              src={
                p.image ??
                `/images/reference/product-${p.id.replace('preview-', '')}.webp`
              }
              alt="Visuel de sélection extrait de la maquette — produit à confirmer"
              icon={
                p.category === 'salon'
                  ? 'couch'
                  : p.category === 'oreillers'
                    ? 'moon'
                    : 'bed'
              }
            />
            <span class="badge">Aperçu</span>
          </div>
          <div class="product-body">
            <h3>{p.label}</h3>
            <p>Référence et dimensions à confirmer.</p>
            <ProductPrice priceMAD={p.priceMAD} />
            <small class="demo-price-note">Prix de démonstration</small>
            <button class="button button-outline" data-dialog="product">
              Voir les informations
              <Icon name="arrow-right" />
            </button>
          </div>
        </article>
      ))}
  </div>
  <div class="product-slider-controls">
    <button
      class="icon-button"
      data-product-prev
      aria-label="Produits précédents"
      aria-controls="product-track"
    >
      <Icon name="caret-left" />
    </button>
    <span data-product-position aria-live="off">
      1–4 / 6
    </span>
    <button
      class="icon-button"
      data-product-next
      aria-label="Produits suivants"
      aria-controls="product-track"
    >
      <Icon name="caret-right" />
    </button>
    <button
      class="icon-button"
      data-product-pause
      aria-label="Mettre les produits en pause"
      aria-pressed="false"
    >
      <Icon name="pause" />
    </button>
  </div>
  <p class="section-note" role="status" id="catalog-status">
    {products.length === 0
      ? 'Catalogue validé en attente. Ces emplacements ne sont pas encore disponibles à la vente.'
      : `${products.length} produits dans la sélection.`}
  </p>
</section>

<script>
  import '../lib/product-slider';
</script>
